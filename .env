# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=Insurance-RCA-Agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Ollama
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# Azure Monitor / Log Analytics
AZURE_SUBSCRIPTION_ID=your-subscription-id
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
AZURE_MONITOR_INGESTION_ENDPOINT=https://<your-ingestion-endpoint>
AZURE_MONITOR_DCR_IMMUTABLE_ID=<your-dcr-immutable-id>
AZURE_MONITOR_STREAM_NAME=<your-dcr-input-stream-name>

# Application Insights
APPINSIGHTS_WORKSPACE_ID=your-application-insights-workspace-id
APPLICATIONINSIGHTS_CONNECTION_STRING=xxxx

# Azure DevOps
AZDO_ORG=your-organization
AZDO_PROJECT=your-project
AZDO_TOKEN=your-pat-token

# Investigation defaults
ENVIRONMENT=sandbox
SERVICE_NAME=policy-api
LOOKBACK_HOURS=2

# Sanitized Terraform change summary
TERRAFORM_CHANGES_FILE=./data/terraform_changes.json

# ServiceNow: use a read-only integration account for historical incident search
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident
SERVICENOW_LOOKBACK_DAYS=90
# Creating incidents is NOT part of autonomous collection. Enable only after approval.
SERVICENOW_ALLOW_CREATE=false

# SonarCloud read-only token and comma-separated project keys
SONARCLOUD_TOKEN=
SONARCLOUD_PROJECT_KEYS=

# Release intelligence
RELEASE_LOOKBACK_DAYS=7
RELEASE_FEEDS_JSON=release_feeds.json

# Scheduler / notifications
INTELLIGENCE_INTERVAL_MINUTES=360
TEAMS_INCOMING_WEBHOOK_URL=
REPORT_DIR=reports
