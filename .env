# Ollama
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# Azure Monitor / Log Analytics
AZURE_SUBSCRIPTION_ID=your-subscription-id
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
AZURE_MONITOR_INGESTION_ENDPOINT=https://<your-ingestion-endpoint>
AZURE_MONITOR_DCR_IMMUTABLE_ID=<your-dcr-immutable-id>
AZURE_MONITOR_STREAM_NAME=<your-dcr-input-stream-name>

# Application Insights
APPINSIGHTS_WORKSPACE_ID=your-application-insights-workspace-id
APPLICATIONINSIGHTS_CONNECTION_STRING=xxxx

# Azure DevOps
AZDO_ORG=your-organization
AZDO_PROJECT=your-project
AZDO_TOKEN=your-pat-token

# Investigation defaults
ENVIRONMENT=sandbox
SERVICE_NAME=policy-api
LOOKBACK_HOURS=2

# Sanitized Terraform change summary
TERRAFORM_CHANGES_FILE=./data/terraform_changes.json